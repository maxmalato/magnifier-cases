// Configuração do Worker. Nenhum segredo nem ID de conta aqui:
// credenciais ficam no painel da Cloudflare, no `wrangler secret` ou nos segredos do GitHub Actions.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nome do Worker = endereço público (casos-da-lupa.SUBDOMINIO.workers.dev), pedido do dono em
  // 27/11/2026. O nome de código continua magnifier-cases. Se o nome público mudar (INPI), mude
  // aqui e no appName.
  "name": "casos-da-lupa",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Sem telemetria do Wrangler (privacidade)
  "send_metrics": false,
  // Sem registros de acesso guardados na Cloudflare (LGPD: nada de dado pessoal em logs)
  "observability": { "enabled": false },
  // Sem endereços de prévia por versão: só um endereço público
  "preview_urls": false,
  // O Worker serve o site (apps/web/dist) e responde primeiro só nas rotas /api/*
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Tempos das salas (ms): o bot assume após TAKEOVER_MS na vez de quem caiu; BOT_STEP_MS entre
  // as jogadas de bot. Limites por minuto e por endereço: ROOM_CREATE_LIMIT salas criadas e
  // ROOM_LOOKUP_LIMIT consultas. Os testes usam outros valores (--var / miniflare bindings).
  "vars": {
    "TAKEOVER_MS": "20000",
    "BOT_STEP_MS": "900",
    "ROOM_CREATE_LIMIT": "10",
    "ROOM_LOOKUP_LIMIT": "60",
  },
  // Uma instância de Room por sala (Durable Object com SQLite, o do plano gratuito)
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
}
